{
  "name": "geez-ai-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "test": "node --env-file-if-exists=.env.local --import tsx scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app lib scripts tests *.ts *.mjs",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "demo:host": "node --env-file-if-exists=.env.local scripts/host-demo.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@clerk/nextjs": "7.9.21",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "file-type": "^22.2.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
